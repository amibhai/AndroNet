# Rebuilt by scripts/build_harness.py
build/
# Re-fetched by scripts/fetch_traces.py or regenerated by lab/gen_dev_traces.py
traces/
tools/
__pycache__/
# Traffic captured on a person's own phone never leaves that machine; only aggregates are kept
results/private/
# Raw device logs can name the hosts a phone contacted
results/*.logcat
results/benign_*.log
# Runs replaced by a repeat, kept locally for reference
results/superseded/
# The emulator writes a large log with nothing in it worth keeping
results/emulator.log
